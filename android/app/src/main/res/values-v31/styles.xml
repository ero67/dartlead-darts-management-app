<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces the launch-theme background with the platform splash
     screen. Without these attributes it centres the launcher icon, whose
     largest layer is 192px, and scales it to 288dp — that upscale is what made
     the logo look blurry. splash_icon is generated per density by
     `npm run android:assets`. -->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:background">@drawable/launch_screen</item>
    </style>
</resources>
