# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Langfuse tracing: project Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps local runs apart from production traces in Langfuse
LANGFUSE_TRACING_ENVIRONMENT=development

# Supabase project holding the doc_chunks table (use staging while developing).
# The anon/publishable key is public; it can only read doc_chunks.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret: only the indexing script uses it, to write doc_chunks. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter: one key for many models (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Model that writes RAG answers, any OpenRouter model id
ANSWER_MODEL=deepseek/deepseek-v4-flash-0731
